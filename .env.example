# --- Supabase (accounts, cloud sync, group spins) ---
# Supabase dashboard → Project Settings → API. Both are safe to expose to the browser;
# database rules in supabase/schema.sql protect the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Place search (optional) ---
# With a key, search uses Google Places (better for small eateries, includes ratings).
# Without it, search uses OpenStreetMap's free Nominatim. Server-only, never sent to the browser.
GOOGLE_MAPS_API_KEY=

# Sent to Nominatim as contact info, per their usage policy.
CONTACT_EMAIL=you@example.com
